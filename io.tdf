# io.tdf
# 定義四個角落 (不佔用封裝外部 Pin 腳)
set_pad_physical_constraints -side 1 -pad_name cornerUL
set_pad_physical_constraints -side 2 -pad_name cornerUR
set_pad_physical_constraints -side 3 -pad_name cornerLR
set_pad_physical_constraints -side 4 -pad_name cornerLL

set IO_SPACE 8.5

# =======================================================
# Side 1 (Top) - 實際使用 28 個 pad，剩餘 4 個註解掉
# =======================================================
set_pad_physical_constraints -side 1 -pad_name io_poc1      -order 1  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name io_vss1      -order 2  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name core_vdd1    -order 3  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name core_vss1    -order 4  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name io_vdd1      -order 5  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_0     -order 6  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_1     -order 7  -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
