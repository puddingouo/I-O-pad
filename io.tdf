set_pad_physical_constraints -side 1 -pad_name ipad_a_11    -order 19 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_12    -order 20 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_13    -order 21 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_14    -order 22 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
