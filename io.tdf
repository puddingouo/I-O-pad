set_pad_physical_constraints -side 1 -pad_name ipad_a_5     -order 11 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_6     -order 12 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_7     -order 13 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name io_vss2      -order 14 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name io_vdd2      -order 15 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_8     -order 16 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_a_9     -order 17 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
