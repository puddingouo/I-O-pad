set_pad_physical_constraints -side 1 -pad_name io_vdd3      -order 25 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name ipad_clk     -order 26 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name io_vss4      -order 27 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
set_pad_physical_constraints -side 1 -pad_name io_vdd4      -order 28 -min_left_iospace $IO_SPACE -min_right_iospace $IO_SPACE
